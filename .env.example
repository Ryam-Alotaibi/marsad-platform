# PostgreSQL — مسار docker-compose (خدمة postgres تُنشئ POSTGRES_USER كـ Superuser
# داخل الحاوية تلقائيًا، ثم infra/postgres-init/01-create-app-role.sql يُنشئ دور
# التطبيق المحدود marsad_app عند أول تشغيل — راجع ذلك الملف)
POSTGRES_USER=marsad
POSTGRES_PASSWORD=marsad_dev_password
POSTGRES_DB=marsad
POSTGRES_PORT=5432
# كلمة مرور دور التطبيق المحدود (marsad_app) — يُستخدم فقط مع docker-compose؛
# غيّريها هنا وبـ infra/postgres-init/01-create-app-role.sql معًا إن أردتِ قيمة مختلفة
APP_DB_PASSWORD=marsad_app_dev_password

# التشغيل المباشر بدون Docker (apps/api/.env) — يتطلب إنشاء الدورين يدويًا بقاعدة
# بيانات محلية موجودة مسبقًا؛ راجع README "التشغيل محليًا".
DATABASE_URL=postgresql://marsad:marsad_dev_password@localhost:5432/marsad
# دور مرتفع الصلاحية (BYPASSRLS) يُستخدم فقط لـ `prisma migrate` و`prisma db seed` —
# يجب ألا يكون الدور الذي يتصل به خادم API الحي. راجع ARCHITECTURE.md
# "عزل الجهات على مستوى قاعدة البيانات (RLS)" لتفاصيل أهمية هذا الفصل.
MIGRATOR_DATABASE_URL=postgresql://marsad_migrator:change_me_migrator_password@localhost:5432/marsad

# API (NestJS)
API_PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ML_SERVICE_URL=http://ml:8000
CORS_ORIGIN=http://localhost:3000

# اختياري — بدون هذه القيم يبقى النظام على المزوّد التجريبي (Mock) الموثّق بـ
# ARCHITECTURE.md، وهو السلوك الافتراضي بهذا المستودع. تفعيلها الحقيقي يتطلب حسابات
# فعلية لا نملكها بهذه البيئة.
# Twilio — إرسال SMS/WhatsApp/مكالمات صوتية حقيقية بدلًا من المعاينة النصية فقط
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# SMTP — إرسال بريد إلكتروني حقيقي
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# OpenAI / Anthropic — يُستخدم لإعادة صياغة إجابات المستشار الذكي بلغة طبيعية أكثر،
# مع الالتزام الصارم بالحقائق المسترجعة فعليًا من قاعدة البيانات (RAG) — لا يُستبدل
# الاسترجاع الحقيقي نفسه، فقط طبقة التوليد اللغوي فوقه. لو الاثنان مُفعَّلان، OpenAI
# يُستخدم أولًا. بدون أي منهما يبقى المستشار يعمل بالردود القالبية المبنية على البيانات
# الحقيقية مباشرة (السلوك الافتراضي بهذا المستودع).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ML service (FastAPI)
ML_PORT=8000
